<?xml version="1.0" encoding="utf-8"?>
<!--
    bg_gradient_primary.xml
    Top-to-bottom linear gradient: #BF360C (Deep Orange 900) → #E65100 (Deep Orange 800)
    Usage: hero banners, app-bar backgrounds, splash screens.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <gradient
        android:angle="270"
        android:centerColor="#CC3A0A"
        android:endColor="#E65100"
        android:startColor="#BF360C"
        android:type="linear" />

</shape>

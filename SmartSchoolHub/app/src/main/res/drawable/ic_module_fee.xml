<?xml version="1.0" encoding="utf-8"?>
<!--
    ic_module_fee.xml
    Fee Management module icon — Indian Rupee currency symbol outline style.
    Material Symbols style, 24×24 viewport.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?attr/colorPrimary">

    <!-- Circle border (coin) -->
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M12,2 m-10,0 a10,10 0 1,0 20,0 a10,10 0 1,0 -20,0"
        android:strokeWidth="2"
        android:strokeColor="#BF360C" />

    <!-- Rupee top horizontal bar -->
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M8,8 L16,8"
        android:strokeWidth="1.8"
        android:strokeColor="#BF360C"
        android:strokeLineCap="round" />

    <!-- Rupee second horizontal bar -->
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M8,11 L16,11"
        android:strokeWidth="1.8"
        android:strokeColor="#BF360C"
        android:strokeLineCap="round" />

    <!-- Rupee vertical stem -->
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M10,8 L10,18"
        android:strokeWidth="1.8"
        android:strokeColor="#BF360C"
        android:strokeLineCap="round" />

    <!-- Rupee diagonal stroke (₹ unique stroke) -->
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M10,11 L15,17"
        android:strokeWidth="1.8"
        android:strokeColor="#BF360C"
        android:strokeLineCap="round" />

    <!-- Cap on top (Devanagari style) -->
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M11,8 C11,8 14,8 14,10.5 C14,11 13.5,11 13,11"
        android:strokeWidth="1.5"
        android:strokeColor="#BF360C"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

</vector>

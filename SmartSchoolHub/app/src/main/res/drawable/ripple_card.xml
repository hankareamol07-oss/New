<?xml version="1.0" encoding="utf-8"?>
<!--
    ripple_card.xml
    Material ripple effect for clickable card surfaces.
    Ripple color: semi-transparent Deep Orange primary.
    Mask: white rectangle (ensures ripple stays within bounds).
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#26BF360C">

    <!-- Mask — constrains ripple to the card's bounds -->
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>

    <!-- Content layer (transparent — actual card bg is set separately) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="16dp" />
        </shape>
    </item>

</ripple>

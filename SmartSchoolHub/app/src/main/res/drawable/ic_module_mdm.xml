<?xml version="1.0" encoding="utf-8"?>
<!--
    ic_module_mdm.xml
    MDM (Mid-Day Meal) module icon — food tray / restaurant outline style.
    Material Symbols style, 24×24 viewport.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?attr/colorPrimary">

    <!-- Fork (left tine stem) -->
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M6.5,4 L6.5,11"
        android:strokeWidth="1.8"
        android:strokeColor="#BF360C"
        android:strokeLineCap="round" />

    <!-- Fork tines top -->
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M5,4 L5,7 C5,8.1 5.9,9 7,9 C8.1,9 9,8.1 9,7 L9,4"
        android:strokeWidth="1.5"
        android:strokeColor="#BF360C"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Fork handle -->
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M7,9 L7,20"
        android:strokeWidth="1.8"
        android:strokeColor="#BF360C"
        android:strokeLineCap="round" />

    <!-- Knife -->
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M13,4 C13,4 14,4 14,4 L14,9 C14,10.1 14.9,11 16,11 L16,4 C16,4 17,4 17,4"
        android:strokeWidth="1.5"
        android:strokeColor="#BF360C"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Knife handle -->
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M15,11 L15,20"
        android:strokeWidth="1.8"
        android:strokeColor="#BF360C"
        android:strokeLineCap="round" />

    <!-- Plate / bowl base line -->
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M3,22 L21,22"
        android:strokeWidth="2"
        android:strokeColor="#BF360C"
        android:strokeLineCap="round" />

</vector>

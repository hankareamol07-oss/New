<?xml version="1.0" encoding="utf-8"?>
<!--
    bg_module_icon.xml
    Rounded rectangle container shape for module icon ImageViews.
    Light orange tinted background (#FBE9E7) with 12dp corners.
    The icon itself is tinted with the primary color separately.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Light orange tint — Deep Orange 50 -->
    <solid android:color="#FBE9E7" />

    <!-- 12dp rounded corners (Material 3 small shape) -->
    <corners android:radius="12dp" />

</shape>

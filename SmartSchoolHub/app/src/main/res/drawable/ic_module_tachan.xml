<?xml version="1.0" encoding="utf-8"?>
<!--
    ic_module_tachan.xml
    Tachan (Lesson Diary) module icon — open notebook / book outline style.
    Material Symbols style, 24×24 viewport.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?attr/colorPrimary">

    <!-- Book outer shape -->
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M4,4 C4,4 4,4 4,4 L4,20 C4,20 4,20 4,20 L12,20 L20,20 C20,20 20,20 20,20 L20,4 C20,4 20,4 20,4 L12,4 Z"
        android:strokeWidth="2"
        android:strokeColor="#BF360C"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Center spine -->
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M12,4 L12,20"
        android:strokeWidth="1.5"
        android:strokeColor="#BF360C"
        android:strokeLineCap="round" />

    <!-- Left page line 1 -->
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M6,9 L10,9"
        android:strokeWidth="1.5"
        android:strokeColor="#BF360C"
        android:strokeLineCap="round" />

    <!-- Left page line 2 -->
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M6,12 L10,12"
        android:strokeWidth="1.5"
        android:strokeColor="#BF360C"
        android:strokeLineCap="round" />

    <!-- Left page line 3 -->
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M6,15 L10,15"
        android:strokeWidth="1.5"
        android:strokeColor="#BF360C"
        android:strokeLineCap="round" />

    <!-- Right page line 1 -->
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M14,9 L18,9"
        android:strokeWidth="1.5"
        android:strokeColor="#BF360C"
        android:strokeLineCap="round" />

    <!-- Right page line 2 -->
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M14,12 L18,12"
        android:strokeWidth="1.5"
        android:strokeColor="#BF360C"
        android:strokeLineCap="round" />

    <!-- Right page line 3 -->
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M14,15 L16,15"
        android:strokeWidth="1.5"
        android:strokeColor="#BF360C"
        android:strokeLineCap="round" />

</vector>

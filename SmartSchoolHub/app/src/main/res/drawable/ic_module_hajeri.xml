<?xml version="1.0" encoding="utf-8"?>
<!--
    ic_module_hajeri.xml
    Hajeri (Attendance) module icon — calendar with checkmark outline style.
    Material Symbols style, 24×24 viewport.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?attr/colorPrimary">

    <!-- Calendar body -->
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M19,4 L5,4 C3.9,4 3,4.9 3,6 L3,20 C3,21.1 3.9,22 5,22 L19,22 C20.1,22 21,21.1 21,20 L21,6 C21,4.9 20.1,4 19,4 Z"
        android:strokeWidth="2"
        android:strokeColor="#BF360C"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Top line (header separator) -->
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M3,10 L21,10"
        android:strokeWidth="1.8"
        android:strokeColor="#BF360C"
        android:strokeLineCap="round" />

    <!-- Left date peg -->
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M8,2 L8,6"
        android:strokeWidth="2"
        android:strokeColor="#BF360C"
        android:strokeLineCap="round" />

    <!-- Right date peg -->
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M16,2 L16,6"
        android:strokeWidth="2"
        android:strokeColor="#BF360C"
        android:strokeLineCap="round" />

    <!-- Checkmark (present/done indicator) -->
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M9,16 L11,18 L15,14"
        android:strokeWidth="2"
        android:strokeColor="#BF360C"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

</vector>

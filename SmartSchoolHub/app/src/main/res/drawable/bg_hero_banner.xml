<?xml version="1.0" encoding="utf-8"?>
<!--
    bg_hero_banner.xml
    Gradient background for the dashboard hero banner section.
    Linear gradient: left-to-right  #BF360C (Deep Orange 900) → #E65100 (Deep Orange 800)
    Angle 0 = left-to-right in Android shape gradient.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <gradient
        android:angle="0"
        android:centerColor="#CC3A0A"
        android:endColor="#E65100"
        android:startColor="#BF360C"
        android:type="linear" />

    <!-- Rounded bottom corners only for the banner feel -->
    <corners
        android:bottomLeftRadius="24dp"
        android:bottomRightRadius="24dp"
        android:topLeftRadius="0dp"
        android:topRightRadius="0dp" />

</shape>

<?xml version="1.0" encoding="utf-8"?>
<!--
    ic_module_paripath.xml
    Paripath (Daily Assembly) module icon — sun / sunrise outline style.
    Material Symbols style, 24×24 viewport.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"

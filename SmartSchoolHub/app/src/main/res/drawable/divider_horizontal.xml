<?xml version="1.0" encoding="utf-8"?>
<!--
    divider_horizontal.xml
    Thin 1dp horizontal divider line.
    Color: 12% black overlay (matches Material 3 divider spec).
    Usage: add as android:background or android:divider on ListViews/LinearLayouts.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Very subtle dark overlay — matches Material 3 outline/divider token -->
    <solid android:color="#1F000000" />

    <!-- 1dp height enforced; width fills parent via layout_width="match_parent" -->
    <size android:height="1dp" />

</shape>

<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/ModuleToolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:subtitle="Bonafide Certificate"
            app:title="@string/bonafide_title" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView style="@style/SectionTitle" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginBottom="10dp"
                android:text="१. विद्यार्थी निवडा" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <com.google.android.material.textfield.TextInputLayout style="@style/FormDropdown"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp" android:layout_weight="1" android:hint="@string/grade">
                    <AutoCompleteTextView android:id="@+id/ddGrade" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout style="@style/FormDropdown"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_marginStart="6dp" android:layout_weight="1" android:hint="@string/section">
                    <AutoCompleteTextView android:id="@+id/ddSection" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilStudent" style="@style/FormDropdown"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="@string/select_student">
                <AutoCompleteTextView android:id="@+id/ddStudent" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:indeterminate="true"
                android:visibility="gone" />

            <TextView style="@style/SectionTitle" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:layout_marginBottom="10dp" android:text="२. दाखला तपशील" />

            <com.google.android.material.textfield.TextInputLayout style="@style/FormDropdown"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="@string/bonafide_purpose">
                <AutoCompleteTextView android:id="@+id/ddPurpose" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout style="@style/FormField"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="शैक्षणिक वर्ष">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etYear"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout style="@style/FormField"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="दाखला क्रमांक (ऐच्छिक)">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etCertNo"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swConduct"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="वर्तणूक चांगली असल्याचा उल्लेख करा"
                android:textColor="@color/text_primary" />

            <!-- Preview -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/module_gr_bg"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <TextView
                    android:id="@+id/tvPreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingMultiplier="1.4"
                    android:padding="16dp"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGenerate"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="16dp"
                android:enabled="false"
                android:text="@string/bonafide_generate"
                app:icon="@drawable/ic_print" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>

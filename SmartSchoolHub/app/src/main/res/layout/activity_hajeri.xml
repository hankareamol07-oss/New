<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/primary"
            app:title="दैनंदिन हजेरी (Attendance)"
            app:titleTextColor="@color/on_primary"
            app:navigationIconTint="@color/on_primary" />

        <!-- Filter bar (Date, Class, Division) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#D84315"
            android:paddingHorizontal="16dp"
            android:paddingBottom="12dp"
            android:gravity="center_vertical">

            <!-- Date Selector Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDate"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_weight="1.4"
                android:layout_height="40dp"
                android:text="2026-09-25"
                android:textSize="12sp"
                app:icon="@drawable/ic_module_hajeri"
                app:iconSize="16dp"
                android:layout_marginEnd="6dp" />

            <!-- Grade Spinner -->
            <Spinner
                android:id="@+id/spGrade"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="40dp"
                android:background="@android:color/white"
                android:layout_marginEnd="6dp" />

            <!-- Section Spinner -->
            <Spinner
                android:id="@+id/spSection"
                android:layout_width="0dp"
                android:layout_weight="0.8"
                android:layout_height="40dp"
                android:background="@android:color/white" />
        </LinearLayout>

        <!-- Stats Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@android:color/white"
            android:padding="12dp"
            android:elevation="2dp"
            android:gravity="center">

            <TextView
                android:id="@+id/tvStatTotal"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="एकूण: 0"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:gravity="center" />

            <View android:layout_width="1dp" android:layout_height="20dp" android:background="#E2E8F0" />

            <TextView
                android:id="@+id/tvStatPresent"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="हजर: 0"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#2E7D32"
                android:gravity="center" />

            <View android:layout_width="1dp" android:layout_height="20dp" android:background="#E2E8F0" />

            <TextView
                android:id="@+id/tvStatAbsent"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="गैरहजर: 0"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#C62828"
                android:gravity="center" />

            <View android:layout_width="1dp" android:layout_height="20dp" android:background="#E2E8F0" />

            <!-- Quick Action: All Present -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAllPresent"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="सर्व हजर ✓"
                android:textColor="#2E7D32"
                android:textSize="12sp"
                android:textStyle="bold"
                android:padding="0dp" />
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Main Content List -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAttendance"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingTop="8dp"
                android:paddingBottom="88dp"
                android:clipToPadding="false" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/layoutEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👥"
                    android:textSize="48sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="या वर्गात कोणतेही विद्यार्थी नाहीत."
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Bottom Save Action Bar -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:cardElevation="12dp"
        app:cardCornerRadius="0dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:background="@android:color/white">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveAttendance"
                style="@style/PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:text="हजेरी जतन करा (Save) 💾"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
    bottom_nav_menu.xml
    Bottom Navigation bar menu for Smart School Hub.
    5 primary destinations in Marathi for Maharashtra teachers.

    Icons use Material Symbols outlined style from the app's own vector drawables
    and the built-in android:icon attribute.
-->
<menu xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        1. Dashboard — डॅशबोर्ड
        Home / overview screen showing stats and quick links.
    -->
    <item
        android:id="@+id/nav_dashboard"
        android:icon="@drawable/ic_bottom_nav_home"
        android:title="@string/nav_dashboard"
        android:menuCategory="secondary"
        android:orderInCategory="0" />

    <!--
        2. Modules — मॉड्युल्स
        Grid of all app modules (HPC, CCE, Tachan, Hajeri, MDM, Fee, Exam…)
    -->
    <item
        android:id="@+id/nav_modules"
        android:icon="@drawable/ic_bottom_nav_modules"
        android:title="@string/nav_modules"
        android:menuCategory="secondary"
        android:orderInCategory="1" />

    <!--
        3. Paripath — परिपाठ
        Daily school assembly planner and tracker.
        Center/prominent item — slightly larger via app-level styling.
    -->
    <item
        android:id="@+id/nav_paripath"
        android:icon="@drawable/ic_module_paripath"
        android:title="@string/nav_paripath"
        android:menuCategory="secondary"
        android:orderInCategory="2" />

    <!--
        4. Students — विद्यार्थी
        Student list, profiles, and management.
    -->
    <item
        android:id="@+id/nav_students"
        android:icon="@drawable/ic_module_students"
        android:title="@string/nav_students"
        android:menuCategory="secondary"
        android:orderInCategory="3" />

    <!--
        5. Profile — प्रोफाइल
        Teacher profile, school settings, and logout.
    -->
    <item
        android:id="@+id/nav_profile"
        android:icon="@drawable/ic_bottom_nav_profile"
        android:title="@string/nav_profile"
        android:menuCategory="secondary"
        android:orderInCategory="4" />

</menu>

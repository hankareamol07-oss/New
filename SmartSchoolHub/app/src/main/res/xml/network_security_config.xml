<?xml version="1.0" encoding="utf-8"?>
<!--
    Network Security Config — Smart School Hub
    Allows HTTP & HTTPS traffic to vijetaacademysangli.in and local dev hosts.
-->
<network-security-config>

    <!-- Domain config for backend and dev servers -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">vijetaacademysangli.in</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </domain-config>

    <!-- Default base config -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <!-- Debug overrides for local development -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>

</network-security-config>

<?xml version="1.0" encoding="utf-8"?>
<!--
    Data Extraction Rules — Smart School Hub (Android 12+)
    Controls both cloud backup and device-to-device transfer.
    Reference via android:dataExtractionRules in AndroidManifest.xml.
-->
<data-extraction-rules>

    <!-- ════════════════════════════════════════
         CLOUD BACKUP (Google One / Drive backup)
         ════════════════════════════════════════ -->
    <cloud-backup>

        <!-- Exclude sensitive SharedPreferences -->
        <exclude
            domain="sharedpref"
            path="auth_prefs.xml" />

        <exclude
            domain="sharedpref"
            path="security_prefs.xml" />

        <exclude
            domain="sharedpref"
            path="user_profile_prefs.xml" />

        <exclude
            domain="sharedpref"
            path="school_prefs.xml" />

        <exclude
            domain="sharedpref"
            path="fcm_prefs.xml" />

        <exclude
            domain="sharedpref"
            path="com.techguruji.smartschoolhub_preferences.xml" />

        <!-- Exclude Room database -->
        <exclude
            domain="database"
            path="smart_school_hub.db" />

        <exclude
            domain="database"
            path="smart_school_hub.db-shm" />

        <exclude
            domain="database"
            path="smart_school_hub.db-wal" />

        <!-- Exclude all internal files (temp, cache, exports) -->
        <exclude
            domain="file"
            path="." />

        <!-- Allow non-sensitive user preferences -->
        <include
            domain="sharedpref"
            path="app_settings.xml" />

        <include
            domain="sharedpref"
            path="language_prefs.xml" />

    </cloud-backup>

    <!-- ════════════════════════════════════════
         DEVICE TRANSFER (device-to-device restore)
         ════════════════════════════════════════ -->
    <device-transfer>

        <!-- Same exclusions as cloud backup for transfer -->
        <exclude
            domain="sharedpref"
            path="auth_prefs.xml" />

        <exclude
            domain="sharedpref"
            path="security_prefs.xml" />

        <exclude
            domain="sharedpref"
            path="user_profile_prefs.xml" />

        <exclude
            domain="sharedpref"
            path="school_prefs.xml" />

        <exclude
            domain="sharedpref"
            path="fcm_prefs.xml" />

        <exclude
            domain="sharedpref"
            path="com.techguruji.smartschoolhub_preferences.xml" />

        <!-- Database files: exclude from transfer -->
        <exclude
            domain="database"
            path="smart_school_hub.db" />

        <exclude
            domain="database"
            path="smart_school_hub.db-shm" />

        <exclude
            domain="database"
            path="smart_school_hub.db-wal" />

        <!-- Exclude internal files -->
        <exclude
            domain="file"
            path="." />

        <!-- Allow non-sensitive user preferences -->
        <include
            domain="sharedpref"
            path="app_settings.xml" />

        <include
            domain="sharedpref"
            path="language_prefs.xml" />

    </device-transfer>

</data-extraction-rules>
